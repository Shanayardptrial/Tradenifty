//@version=6
strategy(title="Garman-Klass Volatility + Momentum Strategy [TradeNifty Pro Clean Boxes]", shorttitle="GK Volatility Strategy", overlay=true, precision=2, initial_capital=40000, default_qty_type=strategy.fixed, default_qty_value=50, commission_type=strategy.commission.cash_per_order, commission_value=20, pyramiding=0)

// ==========================================
// ==== 1. Strategy Inputs & Risk Controls ====
// ==========================================
string g_vol = "Garman-Klass Volatility Settings"
int volMaPeriod = input.int(20, "Volatility MA Period", minval=1, group=g_vol)
float momentumThresh = input.float(0.15, "Bar Momentum Threshold (0.15 = 15%)", step=0.05, group=g_vol)

// Auto-detect whether this is an Option chart (scale < 3000) or Spot Index chart (> 15000)
bool isOptionChart = close < 3000.0

string g_risk = "Risk Management (Auto-Scaled)"
// Spot default: 35 pt SL / 180 pt TP
// Option default: 18 pt SL / 90 pt TP
float slInput = input.float(35.0, "Stop Loss Points (Spot: 35 | Opt: 18)", minval=1.0, group=g_risk)
float tpInput = input.float(180.0, "Target Points (Spot: 180 | Opt: 90)", minval=1.0, group=g_risk)

float slPts = isOptionChart ? math.min(slInput, 20.0) : slInput
float tpPts = isOptionChart ? math.min(tpInput, 90.0) : tpInput

// Maximum 1 Trade per session toggle (Clean trade filter)
bool oneTradePerDay = input.bool(false, "Limit 1 Trade Per Day (Prevents Chop)", group=g_risk)

// ==========================================
// ==== 2. Technical Calculations & Math ====
// ==========================================
// Garman-Klass Volatility Formula
float logHL = math.log(high / math.max(low, 0.0001))
float logCO = math.log(close / math.max(open, 0.0001))
float gkVar = 0.5 * math.pow(logHL, 2) - (2.0 * math.log(2.0) - 1.0) * math.pow(logCO, 2)
float gkVol = math.sqrt(math.max(0.0, gkVar))

// Moving Average of Garman-Klass Volatility
float maVol = ta.sma(gkVol, volMaPeriod)
bool isVolAccel = gkVol > maVol

// Candle Momentum Ratio: (Close - Open) / (High - Low)
float barRange = high - low
float candleMomentum = barRange > 0 ? (close - open) / barRange : 0.0

// Daily Trade Counter
var int tradesToday = 0
if ta.change(time("D")) != 0
    tradesToday := 0

bool canTradeToday = not oneTradePerDay or (tradesToday == 0)

// ==========================================
// ==== 3. Strict Clean Entry & Exit Matrix ====
// ==========================================
// Trigger only when Volatility Accelerates AND High Momentum Breaks Out
bool rawBuyCe = (close > high[1]) and isVolAccel and (candleMomentum > momentumThresh)
bool rawBuyPe = (close < low[1]) and isVolAccel and (candleMomentum < -momentumThresh)

// Strictly trigger ONLY when flat position
bool buyCeCond = rawBuyCe and strategy.position_size == 0 and canTradeToday
bool buyPeCond = rawBuyPe and strategy.position_size == 0 and canTradeToday

// Active Tracking State
var float entryPrice = na
var float slPrice = na
var float tpPrice = na
var int entryBarIndex = na

// Long / Short Drawing Boxes
var box tpBox = na
var box slBox = na
var line entryLine = na

// Execute Long
if buyCeCond
    strategy.entry("Long", strategy.long)
    entryPrice := close
    slPrice := close - slPts
    tpPrice := close + tpPts
    entryBarIndex := bar_index
    tradesToday := tradesToday + 1
    
    // Draw Long Position Tool (Green TP Box UP, Red SL Box DOWN)
    tpBox := box.new(left=bar_index, top=tpPrice, right=bar_index + 12, bottom=entryPrice, 
                     border_color=color.new(#10b981, 20), border_width=1,
                     bgcolor=color.new(#10b981, 82))
    slBox := box.new(left=bar_index, top=entryPrice, right=bar_index + 12, bottom=slPrice, 
                     border_color=color.new(#f43f5e, 20), border_width=1,
                     bgcolor=color.new(#f43f5e, 82))
    entryLine := line.new(x1=bar_index, y1=entryPrice, x2=bar_index + 12, y2=entryPrice, 
                          color=#facc15, width=2)

// Execute Short
if buyPeCond
    strategy.entry("Short", strategy.short)
    entryPrice := close
    slPrice := close + slPts
    tpPrice := close - tpPts
    entryBarIndex := bar_index
    tradesToday := tradesToday + 1
    
    // Draw Short Position Tool (Green TP Box DOWN, Red SL Box UP)
    tpBox := box.new(left=bar_index, top=entryPrice, right=bar_index + 12, bottom=tpPrice, 
                     border_color=color.new(#10b981, 20), border_width=1,
                     bgcolor=color.new(#10b981, 82))
    slBox := box.new(left=bar_index, top=slPrice, right=bar_index + 12, bottom=entryPrice, 
                     border_color=color.new(#f43f5e, 20), border_width=1,
                     bgcolor=color.new(#f43f5e, 82))
    entryLine := line.new(x1=bar_index, y1=entryPrice, x2=bar_index + 12, y2=entryPrice, 
                          color=#facc15, width=2)

// Extend Active Position Drawing Boxes to Current Bar
if strategy.position_size != 0
    if not na(tpBox)
        box.set_right(tpBox, bar_index + 1)
    if not na(slBox)
        box.set_right(slBox, bar_index + 1)
    if not na(entryLine)
        line.set_x2(entryLine, bar_index + 1)

// Order Exits with Limit & Stop
if strategy.position_size > 0
    strategy.exit("Exit Long", "Long", stop=slPrice, limit=tpPrice, comment_loss="SL Hit", comment_profit="Target Hit")

if strategy.position_size < 0
    strategy.exit("Exit Short", "Short", stop=slPrice, limit=tpPrice, comment_loss="SL Hit", comment_profit="Target Hit")

// Reset state on flat
if strategy.position_size == 0 and strategy.position_size[1] != 0
    entryPrice := na
    slPrice := na
    tpPrice := na

// ==========================================
// ==== 4. Clean Non-Cluttered Visuals ====
// ==========================================
// NO REPETITIVE LABELS ON CANDLES. Labels only exist inside the professional Long/Short boxes.
// Clean Active Position Level Lines
plot(strategy.position_size != 0 ? tpPrice : na, "Target Line", color=color.new(#10b981, 0), style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? slPrice : na, "Stop Line", color=color.new(#f43f5e, 0), style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? entryPrice : na, "Entry Line", color=color.new(#facc15, 0), style=plot.style_linebr, linewidth=2)

// Compact Top-Right HUD Stats
var table hud = table.new(position.top_right, 2, 5, bgcolor=color.new(#080c16, 20), border_color=color.new(#facc15, 60), border_width=1)
if barstate.islast
    table.cell(hud, 0, 0, "STRATEGY", bgcolor=color.new(#1e293b, 30), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "GARMAN-KLASS", bgcolor=color.new(#1e293b, 30), text_color=#facc15, text_size=size.small)
    
    table.cell(hud, 0, 1, "GK VOL", bgcolor=color.new(#080c16, 30), text_color=#94a3b8, text_size=size.small)
    table.cell(hud, 1, 1, str.tostring(gkVol, "#.#####"), bgcolor=color.new(#080c16, 30), text_color=isVolAccel ? #10b981 : #f43f5e, text_size=size.small)
    
    table.cell(hud, 0, 2, "VOL ACCEL", bgcolor=color.new(#080c16, 30), text_color=#94a3b8, text_size=size.small)
    table.cell(hud, 1, 2, isVolAccel ? "ACCELERATING" : "NORMAL", bgcolor=color.new(#080c16, 30), text_color=isVolAccel ? #10b981 : #94a3b8, text_size=size.small)

    table.cell(hud, 0, 3, "MOMENTUM", bgcolor=color.new(#080c16, 30), text_color=#94a3b8, text_size=size.small)
    table.cell(hud, 1, 3, str.tostring(candleMomentum, "+#.##;-#.##"), bgcolor=color.new(#080c16, 30), text_color=candleMomentum > 0 ? #10b981 : #f43f5e, text_size=size.small)

    table.cell(hud, 0, 4, "STATUS", bgcolor=color.new(#080c16, 30), text_color=#94a3b8, text_size=size.small)
    table.cell(hud, 1, 4, strategy.position_size > 0 ? "LONG (CE)" : strategy.position_size < 0 ? "SHORT (PE)" : "FLAT (WAIT)", bgcolor=color.new(#080c16, 30), text_color=strategy.position_size > 0 ? #10b981 : strategy.position_size < 0 ? #f43f5e : #cbd5e1, text_size=size.small)
